{
  "name": "exitly",
  "productName": "Exitly",
  "version": "1.0.6",
  "description": "Exitly — ProtonVPN country exits for any Docker project",
  "main": "lib/main/index.js",
  "author": {
    "name": "Exitly contributors",
    "email": "exitly@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/knehrybecki/exitly",
  "repository": {
    "type": "git",
    "url": "https://github.com/knehrybecki/exitly.git"
  },
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:preload && pnpm run build:renderer",
    "build:preload": "esbuild src/preload.ts --bundle --outfile=lib/preload.js --platform=node --format=cjs --external:electron --target=es2022",
    "build:renderer": "esbuild src/renderer/main.ts --bundle --outfile=renderer/renderer.js --platform=browser --target=es2022 --format=iife",
    "test": "vitest run",
    "prestart": "node -e \"require('typescript'); require('esbuild'); require('electron')\"",
    "start": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "pnpm run start",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never",
    "dist:linux": "pnpm run build && electron-builder --linux --publish never",
    "release": "pnpm run build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.1.3"
  },
  "build": {
    "appId": "app.exitly.desktop",
    "productName": "Exitly",
    "copyright": "Copyright © Exitly contributors",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "lib/**/*",
      "renderer/**/*",
      "templates/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../docker-compose.yml",
        "to": "hub/docker-compose.yml"
      },
      {
        "from": "../countries.conf",
        "to": "hub/countries.conf"
      },
      {
        "from": "../.env.example",
        "to": "hub/.env.example"
      },
      {
        "from": "../bin",
        "to": "hub/bin"
      },
      {
        "from": "../snippets",
        "to": "hub/snippets"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "knehrybecki",
        "repo": "exitly",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Exitly",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "synopsis": "ProtonVPN exit switcher for Docker projects",
      "description": "Exitly switches ProtonVPN exit countries and lets any Docker app attach to the shared tunnel."
    },
    "appImage": {
      "license": "../LICENSE"
    }
  }
}
