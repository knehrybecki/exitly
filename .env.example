# Copy: cp .env.example .env
#
# Get the key: Proton Account → VPN → WireGuard → generate a config → copy PrivateKey
# One private key works for EVERY Proton country/server.

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=PASTE_PRIVATE_KEY_HERE

# Default country code for `vpn use` / proton-vpn container (see countries.conf)
ACTIVE_COUNTRY=ro
SERVER_COUNTRIES=Romania

# Optional HTTP proxy exposed by gluetun (handy if an app cannot use network_mode)
HTTPPROXY=on
HTTPPROXY_LISTENING_ADDRESS=:8888
SHADOWSOCKS=off
